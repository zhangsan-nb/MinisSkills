# Desktop/NAS with stable media directories only; don't use for Docker FUSE submount propagation.
# On Windows/macOS Docker Desktop convert paths to mounted host paths supported by Docker Desktop.
PEACH_TAG=edge
PEACH_BIND=127.0.0.1
PEACH_PORT=8900
PEACH_DATA_ROOT=/srv/peach-stack/peach/data
MEDIA_ROOT=/srv/peach-stack/media
