# InstaBox: keep all persistent application state under /data, not the ephemeral root filesystem.
# Local-only Peach is preferred via authenticated CLI/SSH port-forward; public exposure is discouraged.
PEACH_TAG=edge
PEACH_BIND=127.0.0.1
PEACH_PORT=8900
PEACH_DATA_ROOT=/data/home/peach-stack/peach/data
MEDIA_ROOT=/data/home/peach-stack/media
CLOUDDRIVE_TAG=amd64
CLOUDDRIVE_PORT=19798
CLOUDDRIVE_CONFIG_ROOT=/data/home/peach-stack/clouddrive2/Config
JACKETT_TAG=latest
JACKETT_PORT=9117
JACKETT_CONFIG_ROOT=/data/home/peach-stack/jackett/config
JACKETT_PUID=1000
JACKETT_PGID=1000
TZ=Etc/UTC
